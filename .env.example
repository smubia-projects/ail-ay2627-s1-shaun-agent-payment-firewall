# Demo API (api.py on Cloud Run). Copy to .env for local dev. Never commit .env.

# --- AI (any OpenAI-compatible chat-completions gateway; AI Lodge uses apiyi) ---
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key (AI Lodge key bot). The original LLM_API_KEY / LLM_BASE_URL / LLM_MODEL still work.
API_KEY=
# Default model for every role. Claude Haiku matches the headline evaluation (agent and judge).
MODEL_NAME=claude-haiku-4-5-20251001
# The agent being protected, and the firewall's intent judge (each falls back to MODEL_NAME).
AGENT_MODEL_NAME=claude-haiku-4-5-20251001
JUDGE_MODEL_NAME=claude-haiku-4-5-20251001
# Tool-loop turns per agent run in the live demo (each click runs the agent twice)
AGENT_MAX_STEPS=6

# Comma-separated browser origins allowed to call the API (the Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# --- AI Lodge rate limit (fallbacks; the central control sheet overrides them) ---
# Upstash keys come from the batch's shared env, not this file. One "attack" = 2 agent runs + the judge.
RATE_LIMIT_ATTACK_MAX=3
RATE_LIMIT_WINDOW_SECONDS=432000
